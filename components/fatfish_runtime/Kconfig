menu "Fatfish Runtime"

    config APP_CLAW_SYSTEM_UI_ENABLE
        bool
        default n

    config APP_CLAW_MAX_TOOL_ITERATIONS
        int
        default 64
        range 1 1024

    # Compatibility switches consumed by retained upstream Lua/capability
    # components. Agent, IM, router, memory, scheduler, MCP, and skill-manager
    # runtimes are intentionally fixed off in the Fatfish product runtime.
